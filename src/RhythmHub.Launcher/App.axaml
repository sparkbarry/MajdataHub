<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RhythmHub.Launcher.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Follows the system light / dark setting; values mirror macOS system colors. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#F2F2F7" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E5E5EA" />
          <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E8E8ED" />
          <SolidColorBrush x:Key="LabelBrush" Color="#1D1D1F" />
          <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#6E6E73" />
          <SolidColorBrush x:Key="CardBrush" Color="#F5F5F7" />
          <SolidColorBrush x:Key="FloatingCardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#E0E0E5" />
          <SolidColorBrush x:Key="FillBrush" Color="#E8E8ED" />
          <SolidColorBrush x:Key="FillHoverBrush" Color="#DEDEE3" />
          <SolidColorBrush x:Key="SegmentTrackBrush" Color="#E3E3E8" />
          <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LinkBrush" Color="#0066CC" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#1D7A3A" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#C4271C" />
          <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DCDCE1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBrush" Color="#1C1C1E" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#242426" />
          <SolidColorBrush x:Key="SidebarBorderBrush" Color="#000000" />
          <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#3A3A3C" />
          <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2E2E30" />
          <SolidColorBrush x:Key="LabelBrush" Color="#F5F5F7" />
          <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#A1A1A6" />
          <SolidColorBrush x:Key="CardBrush" Color="#2C2C2E" />
          <SolidColorBrush x:Key="FloatingCardBrush" Color="#2C2C2E" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#3A3A3C" />
          <SolidColorBrush x:Key="FillBrush" Color="#3A3A3C" />
          <SolidColorBrush x:Key="FillHoverBrush" Color="#48484A" />
          <SolidColorBrush x:Key="SegmentTrackBrush" Color="#1C1C1E" />
          <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#636366" />
          <SolidColorBrush x:Key="LinkBrush" Color="#4DA3FF" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FF6961" />
          <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3A3A3C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="#0071E3" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0077ED" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#0068D1" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Pill buttons: blue primary, gray secondary. -->
    <Style Selector="Button.pill">
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillHoverBrush}" />
    </Style>
    <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="32,0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>

    <!-- Text-only buttons that read as links. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>

    <!-- Sidebar game list. -->
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #10000000" />
    </Style>

    <!-- Segmented control (a horizontal ListBox). -->
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LabelBrush}" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #1F000000" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.segmented:disabled ListBoxItem">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Thin progress bar. -->
    <Style Selector="ProgressBar.thin">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
    </Style>

    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
      <Setter Property="Margin" Value="18,0,0,0" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Margin" Value="18,0" />
    </Style>
  </Application.Styles>
</Application>
