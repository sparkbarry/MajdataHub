<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:RhythmHub.Launcher.Resources"
        x:Class="RhythmHub.Launcher.Views.AlreadyRunningWindow"
        Title="RhythmHub"
        Width="360" Height="150" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{x:Static res:Strings.AlreadyRunning}" FontSize="16" TextWrapping="Wrap" />
    <Button Content="{x:Static res:Strings.OK}" HorizontalAlignment="Right" Click="OnClose" />
  </StackPanel>
</Window>
